rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Troque pelo(s) e-mail(s) de quem pode usar o sistema
      allow read, write: if request.auth != null
        && request.auth.token.email in ['seu-email@gmail.com'];
    }
  }
}
