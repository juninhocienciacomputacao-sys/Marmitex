rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: troque SEU-EMAIL-AQUI pelo seu e-mail (só uma vez).
    // Os outros usuários você cadastra dentro do sistema, em Ajustes > Usuários do sistema.
    function dono() {
      return request.auth != null && request.auth.token.email in ['SEU-EMAIL-AQUI'];
    }
    function usuarios() {
      return /databases/$(database)/documents/acesso/usuarios;
    }
    function membro() {
      return dono() || (request.auth != null && exists(usuarios())
        && request.auth.token.email in get(usuarios()).data.emails);
    }

    // O sistema: administrador e usuários cadastrados leem e gravam.
    match /{col}/{document=**} {
      allow read: if membro();
      allow write: if membro() && col != 'acesso';
    }

    // Lista de usuários: todos os usuários veem, só o administrador muda.
    match /acesso/{doc} {
      allow read: if membro();
      allow write: if dono();
    }

    // Página de pedido: qualquer pessoa vê o cardápio e o nome do restaurante.
    match /cardapios/{dia} {
      allow read: if true;
    }
    match /publico/{doc} {
      allow read: if true;
    }
    // Página de pedido: confere se o telefone (em código, sem dados pessoais) já tem endereço cadastrado.
    // Só pode consultar um código por vez; ninguém de fora consegue listar.
    match /conhecidos/{h} {
      allow get: if true;
    }
    // Página de pedido: mostra ao cliente quantas marmitas ele já pediu no dia (código de telefone+dia, sem dados pessoais)
    match /pedidosPub/{h} {
      allow get: if true;
    }
    // Versão destas regras: o sistema confere se as regras publicadas são as mais novas.
    match /versaoRegras/{v} {
      allow get: if v == '2026-10-29';
    }

    // Assinatura de plano pela página de atendimento: qualquer pessoa envia, ninguém de fora lê.
    match /assinaturas/{id} {
      allow create, update: if
        request.resource.data.keys().hasOnly(['telefone','nome','planoId','inicio','endereco','entrega','obs','hora','pago'])
        && request.resource.data.keys().hasAll(['telefone','nome','planoId','inicio','endereco','entrega','obs','hora','pago'])
        && request.resource.data.telefone is string
        && request.resource.data.telefone.matches('[0-9]{12,13}')
        && id == request.resource.data.telefone
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.planoId is string && request.resource.data.planoId.size() <= 40
        && request.resource.data.inicio is string && request.resource.data.inicio.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.endereco is string && request.resource.data.endereco.size() <= 300
        && request.resource.data.entrega in ['casa', 'portaria', 'maos']
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 300
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 30
        && request.resource.data.pago in ['', 'informado'];
    }

    // Pedidos pelo link: qualquer pessoa envia o próprio pedido, ninguém de fora lê.
    match /respostas/{id} {
      allow create, update: if
        request.resource.data.keys().hasOnly(['data','telefone','nome','qtd','obs','endereco','hora','entrega','pago'])
        && request.resource.data.keys().hasAll(['data','telefone','nome','qtd','obs','endereco','hora'])
        && request.resource.data.data is string && request.resource.data.data.size() == 10
        && request.resource.data.telefone is string
        && request.resource.data.telefone.matches('[0-9]{12,13}')
        && request.resource.data.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && id == request.resource.data.data + '_' + request.resource.data.telefone
        // só aceita pedido para dia com cardápio publicado e ainda aberto
        && exists(/databases/$(database)/documents/cardapios/$(request.resource.data.data))
        && get(/databases/$(database)/documents/cardapios/$(request.resource.data.data)).data.get('fechado', false) != true
        && request.resource.data.qtd is int && request.resource.data.qtd >= 0 && request.resource.data.qtd <= 20
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 300
        && request.resource.data.endereco is string && request.resource.data.endereco.size() <= 300
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 30
        && (!('entrega' in request.resource.data) || request.resource.data.entrega in ['', 'casa', 'portaria', 'maos'])
        && (!('pago' in request.resource.data) || request.resource.data.pago in ['', 'informado']);
    }
  }
}
